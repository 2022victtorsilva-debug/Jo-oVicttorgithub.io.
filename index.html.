        reviewsCount: 67
      },
      {
        id: 6,
        title: 'Quadro Personalizado do Nosso Dia',
        category: 'personalizados',
        description: 'Quadro A4 em madeira nobre com o mapa das estrelas exato do dia do seu namoro.',
        price: 89.90,
        image: 'https://images.unsplash.com/photo-1513519245088-0e12902e5a38?auto=format&fit=crop&w=800&q=80',
        badge: 'Exclusivo',
        badgeColor: 'bg-rose-600',
        rating: 5.0,
        reviewsCount: 156
      }
    ];

    const GALLERY_IMAGES = [
      { id: 1, url: 'https://images.unsplash.com/photo-1522673607200-164d1b6ce486?auto=format&fit=crop&w=800&q=80', title: 'Casal no Pôr do Sol', tag: 'Romântico' },
      { id: 2, url: 'https://images.unsplash.com/photo-1584445584405-b0b8c04ecad9?auto=format&fit=crop&w=800&q=80', title: 'Surpresa de Aniversário', tag: 'Presentes' },
      { id: 3, url: 'https://images.unsplash.com/photo-1518199266791-5375a83190b7?auto=format&fit=crop&w=800&q=80', title: 'Viagem Inesquecível', tag: 'Momentos' },
      { id: 4, url: 'https://images.unsplash.com/photo-1611591475155-42e6212e3428?auto=format&fit=crop&w=800&q=80', title: 'Pulseiras Unindo Mãos', tag: 'Detalhes' },
      { id: 5, url: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=800&q=80', title: 'Sorrisos Sinceros', tag: 'Amor' },
      { id: 6, url: 'https://images.unsplash.com/photo-1516589178581-6cd7833ae3b2?auto=format&fit=crop&w=800&q=80', title: 'Jantar Conectado', tag: 'Jantar' },
    ];

    function App() {
      const [currentPath, setCurrentPath] = useState('/');
      const [cart, setCart] = useState([]);
      const [isCartOpen, setIsCartOpen] = useState(false);
      const [isCheckoutOpen, setIsCheckoutOpen] = useState(false);
      const [isSuccessOpen, setIsSuccessOpen] = useState(false);
      const [mobileMenuOpen, setMobileMenuOpen] = useState(false);

      const navigate = (path) => {
        setCurrentPath(path);
        setMobileMenuOpen(false);
        window.scrollTo({ top: 0, behavior: 'smooth' });
      };

      const addToCart = (product) => {
        setCart(prev => {
          const exists = prev.find(item => item.id === product.id);
          if (exists) {
            return prev.map(item => item.id === product.id ? { ...item, quantity: item.quantity + 1 } : item);
          }
          return [...prev, { ...product, quantity: 1 }];
        });
        setIsCartOpen(true);
      };

      const removeFromCart = (id) => {
        setCart(prev => prev.filter(item => item.id !== id));
      };

      const updateQuantity = (id, delta) => {
        setCart(prev => prev.map(item => {
          if (item.id === id) {
            const newQty = item.quantity + delta;
            return newQty > 0 ? { ...item, quantity: newQty } : item;
          }
          return item;
        }));
      };

      const cartTotal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
      const cartCount = cart.reduce((sum, item) => sum + item.quantity, 0);

      return (
        <div className="min-h-screen flex flex-col justify-between">
          
          {/* HEADER */}
          <header className="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-rose-100 shadow-sm">
            <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
              <div className="flex items-center justify-between h-20">
                <button onClick={() => navigate('/')} className="flex items-center space-x-2">
                  <div className="w-10 h-10 rounded-full bg-rose-600 flex items-center justify-center text-white shadow-md">
                    ♥
                  </div>
                  <span className="font-serif text-2xl font-bold tracking-tight text-gray-900">
                    Amor<span className="text-rose-600">emPar</span>
                  </span>
                </button>

                {/* NAV DESKTOP */}
                <nav className="hidden md:flex items-center space-x-8 font-medium">
                  <button onClick={() => navigate('/')} className={`py-1 border-b-2 text-sm font-semibold ${currentPath === '/' ? 'text-rose-600 border-rose-600' : 'text-gray-600 border-transparent hover:text-rose-600'}`}>Início</button>
                  <button onClick={() => navigate('/sobre')} className={`py-1 border-b-2 text-sm font-semibold ${currentPath === '/sobre' ? 'text-rose-600 border-rose-600' : 'text-gray-600 border-transparent hover:text-rose-600'}`}>Sobre Nós</button>
                  <button onClick={() => navigate('/servicos')} className={`py-1 border-b-2 text-sm font-semibold ${currentPath === '/servicos' ? 'text-rose-600 border-rose-600' : 'text-gray-600 border-transparent hover:text-rose-600'}`}>Coleção</button>
                  <button onClick={() => navigate('/galeria')} className={`py-1 border-b-2 text-sm font-semibold ${currentPath === '/galeria' ? 'text-rose-600 border-rose-600' : 'text-gray-600 border-transparent hover:text-rose-600'}`}>Galeria</button>
                  <button onClick={() => navigate('/contato')} className={`py-1 border-b-2 text-sm font-semibold ${currentPath === '/contato' ? 'text-rose-600 border-rose-600' : 'text-gray-600 border-transparent hover:text-rose-600'}`}>Contato</button>
                </nav>

                {/* CARRINHO BOTÃO */}
                <div className="flex items-center space-x-4">
                  <button onClick={() => setIsCartOpen(true)} className="relative p-2.5 rounded-full text-gray-700 hover:bg-rose-50 transition border border-gray-200">
                    🛒
                    {cartCount > 0 && (
                      <span className="absolute -top-1 -right-1 bg-rose-600 text-white text-xs font-bold rounded-full w-5 h-5 flex items-center justify-center">
                        {cartCount}
                      </span>
                    )}
                  </button>
                  <button onClick={() => setMobileMenuOpen(!mobileMenuOpen)} className="md:hidden p-2 text-gray-600">
                    ☰
                  </button>
                </div>
              </div>
            </div>

            {/* NAV MOBILE */}
            {mobileMenuOpen && (
              <div className="md:hidden bg-white border-b border-rose-100 px-4 py-4 space-y-2">
                <button onClick={() => navigate('/')} className="block w-full text-left py-2 font-semibold text-gray-700">Início</button>
                <button onClick={() => navigate('/sobre')} className="block w-full text-left py-2 font-semibold text-gray-700">Sobre Nós</button>
                <button onClick={() => navigate('/servicos')} className="block w-full text-left py-2 font-semibold text-gray-700">Coleção</button>
                <button onClick={() => navigate('/galeria')} className="block w-full text-left py-2 font-semibold text-gray-700">Galeria</button>
                <button onClick={() => navigate('/contato')} className="block w-full text-left py-2 font-semibold text-gray-700">Contato</button>
              </div>
            )}
          </header>

          {/* CONTEÚDO DAS PÁGINAS */}

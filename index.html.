                  </div>
                  <div>
                    <label className="block text-xs font-bold uppercase text-gray-600 mb-1">Mensagem</label>
                    <textarea rows="4" className="w-full border rounded-lg p-3 outline-none focus:ring-2 focus:ring-rose-500" placeholder="Como podemos te ajudar?"></textarea>

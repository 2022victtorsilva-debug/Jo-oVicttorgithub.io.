                    <div className="space-y-6 text-center md:text-left">
                      <h1 className="font-serif text-4xl sm:text-6xl font-bold text-gray-900">Eternize seu amor com gestos inesquecíveis.</h1>
                      <p className="text-lg text-gray-600">Presentes pensados exclusivamente para fortalecer conexões e criar memórias.</p>
                      <button onClick={() => navigate('/servicos')} className="px-8 py-4 bg-rose-600 hover:bg-rose-700 text-white font-bold rounded-full shadow-lg">
                        Conhecer Coleção &rarr;
                      </button>
                    </div>
                    <img src="https://images.unsplash.com/photo-1518199266791-5375a83190b7?auto=format&fit=crop&w=800&q=80" className="rounded-3xl shadow-2xl w-full aspect-square object-cover" />
                  </div>
                </section>

                <section className="max-w-7xl mx-auto px-4">
                  <h2 className="font-serif text-3xl font-bold mb-8">Destaques da Loja</h2>
                  <div className="grid grid-cols-1 md:grid-cols-3 gap-8">
                    {PRODUCTS.slice(0, 3).map(p => (
                      <div key={p.id} className="bg-white rounded-2xl border border-gray-100 overflow-hidden shadow-sm hover:shadow-md transition">
                        <img src={p.image} className="w-full aspect-square object-cover" />
                        <div className="p-6">
                          <h3 className="font-serif text-xl font-bold">{p.title}</h3>
                          <p className="text-gray-600 text-sm mt-2">{p.description}</p>
                          <div className="mt-4 flex justify-between items-center">
                            <span className="text-xl font-bold">R$ {p.price.toFixed(2)}</span>
                            <button onClick={() => addToCart(p)} className="bg-rose-600 text-white px-4 py-2 rounded-xl text-sm font-bold">Adicionar</button>
                          </div>
                        </div>
                      </div>
                    ))}
                  </div>
                </section>
              </div>
            )}

            {currentPath === '/sobre' && (
              <div className="py-12 max-w-7xl mx-auto px-4 space-y-12">
